<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kompilator fabuły uruchamiany automatycznie podczas budowania aplikacji (patrz LittleVillage.csproj, target CompileInkStory).
       Ręcznie: dotnet run (w katalogu narzędzia) z argumentami: main.ink story.json -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\ink\compiler\ink_compiler.csproj" />
  </ItemGroup>

</Project>
