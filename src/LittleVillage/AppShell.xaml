<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LittleVillage.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LittleVillage.Views"
    Title="LittleVillage"
    FlyoutBehavior="Disabled">

    <!-- Przepływ: splash -> menu -> gra (trasa „game” rejestrowana w MauiProgram). -->
    <ShellContent Route="splash" ContentTemplate="{DataTemplate views:SplashPage}" />
    <ShellContent Route="menu" ContentTemplate="{DataTemplate views:MainMenuPage}" />

</Shell>
