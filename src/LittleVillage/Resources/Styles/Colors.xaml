<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Kolory pochodzą z LittleVillage.Theme.Palette (jedno źródło prawdy). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:theme="clr-namespace:LittleVillage.Theme">

    <x:Static x:Key="Ink" Member="theme:Palette.Ink" />
    <x:Static x:Key="Paper" Member="theme:Palette.Paper" />
    <x:Static x:Key="PaperTranslucent" Member="theme:Palette.PaperTranslucent" />
    <x:Static x:Key="White" Member="theme:Palette.White" />
    <x:Static x:Key="Ash" Member="theme:Palette.Ash" />
    <x:Static x:Key="Blood" Member="theme:Palette.Blood" />
    <x:Static x:Key="BloodDark" Member="theme:Palette.BloodDark" />
    <x:Static x:Key="Scrim" Member="theme:Palette.Scrim" />

    <!-- Kolory zależne od trybu jasny/ciemny. Wartości startowe = tryb jasny;
         ThemeService podmienia je w locie, widoki używają ich przez DynamicResource. -->
    <x:Static x:Key="TextInk" Member="theme:Palette.Ink" />
    <x:Static x:Key="TextMuted" Member="theme:Palette.Ash" />
    <x:Static x:Key="PanelBackground" Member="theme:Palette.PaperTranslucent" />
    <x:Static x:Key="PanelSolid" Member="theme:Palette.Paper" />
    <x:Static x:Key="PanelStroke" Member="theme:Palette.Ink" />
    <x:Static x:Key="ButtonFace" Member="theme:Palette.Paper" />
    <x:Static x:Key="ButtonInk" Member="theme:Palette.Ink" />

</ResourceDictionary>
