<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:LittleVillage.Controls">

    <!-- Konwertery (CommunityToolkit.Maui) -->
    <toolkit:InvertedBoolConverter x:Key="InvertedBool" />

    <!-- Teksty stałe gry -->
    <x:String x:Key="GameTitle">Mała wioska</x:String>
    <x:String x:Key="GameSubtitle">Opowieść z zapomnianej wsi</x:String>

    <!-- Menu główne: podtytuł czytany razem z nazwą wsi -->
    <x:String x:Key="MainMenuSubtitle">Opowieść z małej zapomnianej wsi zwanej</x:String>
    <x:String x:Key="MainMenuTitle">Zapadlina</x:String>

    <!-- ===== Style domyślne ===== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Ink}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.FlyoutBehavior" Value="Disabled" />
    </Style>

    <!-- Baza wszystkich etykiet. Style z kluczem dziedziczą po niej (BasedOn),
         bo jawny styl w MAUI zastępuje styl domyślny zamiast go uzupełniać. -->
    <Style x:Key="BaseLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Alegreya" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource TextInk}" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />

    <Style TargetType="ScrollView">
        <Setter Property="VerticalScrollBarVisibility" Value="Default" />
    </Style>

    <!-- ===== Kontrolki gry — kolory zależne od trybu jasny/ciemny ===== -->

    <!-- Styl z kluczem, by jawne style przycisków mogły po nim dziedziczyć (BasedOn). -->
    <Style x:Key="SketchButtonTheme" TargetType="controls:SketchButton">
        <Setter Property="FaceColor" Value="{DynamicResource ButtonFace}" />
        <Setter Property="InkColor" Value="{DynamicResource ButtonInk}" />
    </Style>

    <Style TargetType="controls:SketchButton" ApplyToDerivedTypes="True" BasedOn="{StaticResource SketchButtonTheme}" />

    <Style TargetType="controls:InkFrame">
        <Setter Property="FrameBackgroundColor" Value="{DynamicResource PanelBackground}" />
        <Setter Property="FrameStrokeColor" Value="{DynamicResource PanelStroke}" />
    </Style>

    <Style TargetType="controls:ThemedImage">
        <Setter Property="TintColor" Value="{DynamicResource TextInk}" />
    </Style>

    <!-- ===== Tekst fabuły (wartości z makiety) ===== -->

    <!-- „Rozdział pierwszy” -->
    <Style x:Key="StoryChapter" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="AlegreyaItalic" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Tytuły: gry, rozdziałów, okien -->
    <Style x:Key="StoryTitle" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="PirataOne" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="LineHeight" Value="1.05" />
    </Style>

    <Style x:Key="StoryParagraph" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="1.55" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- „Co robisz?” -->
    <Style x:Key="StoryQuestion" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="PirataOne" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>

    <!-- Podpowiedzi, podpisy -->
    <Style x:Key="Hint" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="AlegreyaItalic" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style x:Key="ItemName" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="AlegreyaBold" />
        <Setter Property="FontSize" Value="18" />
    </Style>

</ResourceDictionary>
