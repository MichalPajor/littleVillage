<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="LittleVillage.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:LittleVillage.Resources.Strings"
    xmlns:controls="clr-namespace:LittleVillage.Controls"
    xmlns:views="clr-namespace:LittleVillage.Views"
    xmlns:vm="clr-namespace:LittleVillage.ViewModels"
    x:DataType="vm:SettingsViewModel">

    <Grid>
        <controls:SceneBackgroundView Scene="{Binding Scene}" IsInverted="{DynamicResource SceneInverted}" />

        <controls:InkFrame
            Margin="20,0"
            FrameBackgroundColor="{DynamicResource PanelSolid}"
            MaximumWidthRequest="440"
            VerticalOptions="Center">
            <Grid Padding="22,26,18,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

                <Label Text="{x:Static res:AppResources.SettingsTitle}" Style="{StaticResource StoryTitle}" FontSize="34" VerticalOptions="Center" />
                <controls:SketchIconButton
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    FaceSize="40,40"
                    IconSize="20"
                    Icon="ic_close.png"
                    StrokeThickness="3"
                    ShadowOffset="3"
                    Command="{Binding CloseCommand}"
                    SemanticProperties.Description="{x:Static res:AppResources.BackToMenu}" />

                <controls:ThemedImage Grid.Row="1" Source="decor_underline.png" WidthRequest="150" HeightRequest="8" Aspect="Fill" HorizontalOptions="Start" />

                <VerticalStackLayout Grid.Row="2" Margin="0,18,0,0" Spacing="14" IsVisible="{Binding IsSettingsListVisible}">
                    <!-- Próbka tekstu w wybranej wielkości -->
                    <controls:StoryTextLabel Style="{StaticResource StoryParagraph}" StoryText="{x:Static res:AppResources.TextSample}" />
                    <controls:SketchTextButton Text="{Binding TextSizeLabel}" FontSize="22" Command="{Binding ChangeTextSizeCommand}" />

                    <Label Margin="0,10,0,0" Style="{StaticResource Hint}" Text="{x:Static res:AppResources.ParallaxHint}" />
                    <controls:SketchTextButton Text="{Binding ParallaxLabel}" FontSize="22" CornerRadius="10,15,16,11" Command="{Binding ToggleParallaxCommand}" />

                    <controls:SketchTextButton Margin="0,10,0,0" Text="{Binding LanguageLabel}" FontSize="22" CornerRadius="14,11,10,15" Command="{Binding OpenLanguagesCommand}" />
                </VerticalStackLayout>

                <!-- Wybór języka -->
                <ScrollView Grid.Row="2" Margin="0,18,0,0" MaximumHeightRequest="460" IsVisible="{Binding IsLanguageListOpen}">
                    <VerticalStackLayout Spacing="12" Padding="0,0,4,8" BindableLayout.ItemsSource="{Binding Languages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageItem">
                                <controls:SketchTextButton Text="{Binding Name}" FontSize="22" Command="{Binding Command}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </controls:InkFrame>
    </Grid>

</views:BasePage>
