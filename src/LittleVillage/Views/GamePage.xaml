<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="LittleVillage.Views.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:LittleVillage.Resources.Strings"
    xmlns:controls="clr-namespace:LittleVillage.Controls"
    xmlns:story="clr-namespace:LittleVillage.Core.Story;assembly=LittleVillage.Core"
    xmlns:views="clr-namespace:LittleVillage.Views"
    xmlns:vm="clr-namespace:LittleVillage.ViewModels"
    x:DataType="vm:GameViewModel">

    <views:BasePage.Resources>
        <!-- Wygląd elementów tekstu fabuły -->
        <controls:StoryBlockTemplateSelector x:Key="StoryBlockSelector">
            <controls:StoryBlockTemplateSelector.ChapterTemplate>
                <DataTemplate x:DataType="story:StoryBlock">
                    <Label Text="{Binding Text}" Style="{StaticResource StoryChapter}" Margin="0,0,0,-14" />
                </DataTemplate>
            </controls:StoryBlockTemplateSelector.ChapterTemplate>

            <controls:StoryBlockTemplateSelector.TitleTemplate>
                <DataTemplate x:DataType="story:StoryBlock">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding Text}" Style="{StaticResource StoryTitle}" />
                        <controls:ThemedImage Source="decor_underline.png" WidthRequest="190" HeightRequest="10" Aspect="Fill" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:StoryBlockTemplateSelector.TitleTemplate>

            <controls:StoryBlockTemplateSelector.ParagraphTemplate>
                <DataTemplate x:DataType="story:StoryBlock">
                    <controls:StoryTextLabel
                        Style="{StaticResource StoryParagraph}"
                        StoryText="{Binding Text}"
                        HasDropCap="{Binding HasDropCap}" />
                </DataTemplate>
            </controls:StoryBlockTemplateSelector.ParagraphTemplate>

            <controls:StoryBlockTemplateSelector.DividerTemplate>
                <DataTemplate x:DataType="story:StoryBlock">
                    <controls:ThemedImage Source="decor_divider.png" HeightRequest="18" Aspect="AspectFit" HorizontalOptions="Fill" />
                </DataTemplate>
            </controls:StoryBlockTemplateSelector.DividerTemplate>
        </controls:StoryBlockTemplateSelector>
    </views:BasePage.Resources>

    <!-- Proporcje z makiety 390×844: okno fabuły zaczyna się na wysokości 432. -->
    <Grid RowDefinitions="432*,412*">

        <!-- Tło sceny z animowanymi warstwami -->
        <controls:SceneBackgroundView x:Name="SceneView" Grid.RowSpan="2" Scene="{Binding Scene}" IsInverted="{DynamicResource SceneInverted}" />

        <!-- Ekwipunek -->
        <controls:SketchIconButton
            x:Name="BackpackButton"
            Grid.Row="0"
            Margin="0,28,12,0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            FaceSize="58,58"
            IconSize="34"
            Icon="ic_backpack.png"
            StrokeThickness="4"
            CornerRadius="14,10,9,16"
            Command="{Binding OpenInventoryCommand}"
            SemanticProperties.Description="{x:Static res:AppResources.OpenInventory}" />

        <!-- Zapiski (bestiariusz): karty istot odsłaniane razem z fabułą -->
        <controls:SketchIconButton
            x:Name="JournalButton"
            Grid.Row="0"
            Margin="0,100,16,0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            FaceSize="50,50"
            IconSize="30"
            Icon="ic_journal.png"
            StrokeThickness="3.5"
            CornerRadius="12,14,10,13"
            Command="{Binding OpenJournalCommand}"
            SemanticProperties.Description="{x:Static res:AppResources.OpenJournal}" />

        <!-- Tryb jasny / ciemny okien z tekstem: księżyc = przełącz na ciemny, słońce = na jasny -->
        <controls:SketchIconButton
            Grid.Row="0"
            Margin="0,164,19,0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            FaceSize="44,44"
            IconSize="24"
            StrokeThickness="3"
            ShadowOffset="3"
            CornerRadius="12,9,13,10"
            Command="{Binding ToggleThemeCommand}"
            SemanticProperties.Description="{x:Static res:AppResources.ToggleTheme}">
            <controls:SketchIconButton.Style>
                <Style TargetType="controls:SketchIconButton" BasedOn="{StaticResource SketchButtonTheme}">
                    <Setter Property="Icon" Value="ic_theme_dark.png" />
                    <Style.Triggers>
                        <DataTrigger TargetType="controls:SketchIconButton" Binding="{Binding IsDarkMode}" Value="True">
                            <Setter Property="Icon" Value="ic_theme_light.png" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:SketchIconButton.Style>
        </controls:SketchIconButton>

        <!-- Okno fabuły; dolna krawędź schowana poza ekranem (ujemny margines) -->
        <controls:InkFrame
            Grid.Row="1"
            Margin="12,0,12,-16"
            FrameCornerRadius="6,10,0,0"
            controls:SlideAway.IsCollapsed="{Binding IsPanelCollapsed}"
            controls:SlideAway.ExtraDistance="28"
            SemanticProperties.Description="{x:Static res:AppResources.StoryTextDescription}">

            <ScrollView x:Name="StoryScroll" Margin="4,4,2,0">
                <VerticalStackLayout x:Name="StoryContent" Padding="16,34,14,56" Spacing="14">

                    <VerticalStackLayout
                        x:Name="StoryBlocks"
                        Spacing="14"
                        BindableLayout.ItemsSource="{Binding Blocks}"
                        BindableLayout.ItemTemplateSelector="{StaticResource StoryBlockSelector}" />

                    <Label Text="{Binding Question}" Style="{StaticResource StoryQuestion}" IsVisible="{Binding HasChoices}" />

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Choices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChoiceViewModel">
                                <controls:SketchChoiceButton
                                    Numeral="{Binding Numeral}"
                                    Text="{Binding Text}"
                                    IsSelected="{Binding IsSelected}"
                                    CornerRadius="{Binding CornerRadius}"
                                    Command="{Binding SelectCommand}"
                                    SemanticProperties.Description="{Binding Text}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding EndingNote}" Style="{StaticResource Hint}" IsVisible="{Binding HasEndingNote}" />

                    <Grid x:Name="StoryFooter" MinimumHeightRequest="76">
                        <Label
                            Text="{x:Static res:AppResources.ChoiceHint}"
                            Style="{StaticResource Hint}"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            IsVisible="{Binding ShowChoiceHint}" />
                        <controls:SketchIconButton
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            FaceSize="66,66"
                            IconSize="38"
                            Icon="ic_arrow_right.png"
                            StrokeThickness="4"
                            ShadowOffset="5"
                            CornerRadius="16,11,10,18"
                            Command="{Binding AdvanceCommand}"
                            IsVisible="{Binding CanAdvance}"
                            SemanticProperties.Description="{x:Static res:AppResources.Next}" />
                        <controls:SketchTextButton
                            Text="{x:Static res:AppResources.TryAgain}"
                            Command="{Binding TryAgainCommand}"
                            IsVisible="{Binding IsDeath}"
                            SemanticProperties.Description="{x:Static res:AppResources.TryAgainDescription}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </controls:InkFrame>

        <!-- Zwiń / rozwiń okno fabuły -->
        <controls:SketchIconButton
            Grid.Row="1"
            Margin="0,-20,30,0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            FaceSize="44,44"
            IconSize="22"
            StrokeThickness="3"
            ShadowOffset="3"
            CornerRadius="10,12,13,9"
            Command="{Binding TogglePanelCommand}"
            controls:SlideAway.IsCollapsed="{Binding IsPanelCollapsed}"
            controls:SlideAway.IncludeWidth="False"
            controls:SlideAway.ExtraDistance="8"
            SemanticProperties.Description="{x:Static res:AppResources.TogglePanel}">
            <controls:SketchIconButton.Style>
                <Style TargetType="controls:SketchIconButton" BasedOn="{StaticResource SketchButtonTheme}">
                    <Setter Property="Icon" Value="ic_panel_hide.png" />
                    <Style.Triggers>
                        <DataTrigger TargetType="controls:SketchIconButton" Binding="{Binding IsPanelCollapsed}" Value="True">
                            <Setter Property="Icon" Value="ic_panel_show.png" />
                            <Setter Property="CornerRadius" Value="12,0,12,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:SketchIconButton.Style>
        </controls:SketchIconButton>

        <!-- ===== Zmiana ekwipunku: karteczka „+ przedmiot” / „− przedmiot” wysuwa się spod tobołka ===== -->
        <controls:InkFrame
            x:Name="InventoryToast"
            Grid.Row="0"
            Margin="0,30,82,0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            ShowBlood="False"
            FrameBackgroundColor="{DynamicResource PanelSolid}"
            Opacity="0"
            IsVisible="False"
            InputTransparent="True">
            <HorizontalStackLayout Padding="14,8,16,8" Spacing="8">
                <Label x:Name="InventoryToastSign" FontFamily="{DynamicResource FontBodyBold}" FontSize="24" TextColor="{StaticResource Blood}" VerticalOptions="Center" />
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label x:Name="InventoryToastCaption" Style="{StaticResource Hint}" FontSize="12" />
                    <Label x:Name="InventoryToastName" Style="{StaticResource ItemName}" FontSize="17" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </controls:InkFrame>

        <!-- ===== Zapiski (nakładka) ===== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsJournalOpen}">
            <BoxView Color="{StaticResource Scrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseJournalCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <controls:InkFrame
                Margin="20,60"
                FrameBackgroundColor="{DynamicResource PanelSolid}"
                MaximumWidthRequest="440"
                VerticalOptions="Center">
                <Grid Padding="22,26,18,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

                    <Label Text="{x:Static res:AppResources.JournalTitle}" Style="{StaticResource StoryTitle}" FontSize="34" VerticalOptions="Center" />
                    <controls:SketchIconButton
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        FaceSize="40,40"
                        IconSize="20"
                        Icon="ic_close.png"
                        StrokeThickness="3"
                        ShadowOffset="3"
                        Command="{Binding CloseJournalCommand}"
                        SemanticProperties.Description="{x:Static res:AppResources.CloseJournal}" />

                    <controls:ThemedImage Grid.Row="1" Source="decor_underline.png" WidthRequest="150" HeightRequest="8" Aspect="Fill" HorizontalOptions="Start" />

                    <ScrollView Grid.Row="2" Margin="0,18,0,6" MaximumHeightRequest="440">
                        <VerticalStackLayout Spacing="22">
                            <Label Text="{x:Static res:AppResources.JournalEmpty}" Style="{StaticResource Hint}" IsVisible="{Binding HasJournalEntries, Converter={StaticResource InvertedBool}}" />
                            <VerticalStackLayout Spacing="22" BindableLayout.ItemsSource="{Binding JournalEntries}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="story:JournalEntry">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Title}" Style="{StaticResource ItemName}" FontSize="20" />
                                            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Notes}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Label Text="{Binding .}" Style="{StaticResource Hint}" LineHeight="1.35" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </controls:InkFrame>
        </Grid>

        <!-- ===== Ekwipunek (nakładka) ===== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsInventoryOpen}">
            <BoxView Color="{StaticResource Scrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseInventoryCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <controls:InkFrame
                x:Name="InventoryFrame"
                Margin="24,72"
                FrameBackgroundColor="{DynamicResource PanelSolid}"
                MaximumWidthRequest="420"
                VerticalOptions="Center">
                <!-- Okno dopasowuje się do liczby przedmiotów; przy długiej liście lista się przewija. -->
                <Grid Padding="22,26,18,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

                    <Label Text="{x:Static res:AppResources.InventoryTitle}" Style="{StaticResource StoryTitle}" FontSize="34" VerticalOptions="Center" />
                    <controls:SketchIconButton
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        FaceSize="40,40"
                        IconSize="20"
                        Icon="ic_close.png"
                        StrokeThickness="3"
                        ShadowOffset="3"
                        Command="{Binding CloseInventoryCommand}"
                        SemanticProperties.Description="{x:Static res:AppResources.CloseInventory}" />

                    <controls:ThemedImage Grid.Row="1" Source="decor_underline.png" WidthRequest="150" HeightRequest="8" Aspect="Fill" HorizontalOptions="Start" />

                    <ScrollView Grid.Row="2" Margin="0,18,0,0" MaximumHeightRequest="440">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="{x:Static res:AppResources.InventoryEmpty}" Style="{StaticResource Hint}" IsVisible="{Binding HasInventoryItems, Converter={StaticResource InvertedBool}}" />
                            <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding InventoryItems}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="story:InventoryItem">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" Style="{StaticResource ItemName}" />
                                            <Label Text="{Binding Description}" Style="{StaticResource Hint}" LineHeight="1.35" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </controls:InkFrame>
        </Grid>

        <!-- ===== Pełna wersja (nakładka na końcu darmowej części) ===== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsFullVersionOpen}">
            <BoxView Color="{StaticResource Scrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseFullVersionCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <controls:InkFrame
                Margin="24,72"
                FrameBackgroundColor="{DynamicResource PanelSolid}"
                MaximumWidthRequest="420"
                VerticalOptions="Center">
                <Grid Padding="22,26,18,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

                    <Label Text="{x:Static res:AppResources.FullVersionTitle}" Style="{StaticResource StoryTitle}" FontSize="34" VerticalOptions="Center" />
                    <controls:SketchIconButton
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        FaceSize="40,40"
                        IconSize="20"
                        Icon="ic_close.png"
                        StrokeThickness="3"
                        ShadowOffset="3"
                        Command="{Binding CloseFullVersionCommand}"
                        SemanticProperties.Description="{x:Static res:AppResources.Close}" />

                    <controls:ThemedImage Grid.Row="1" Source="decor_underline.png" WidthRequest="150" HeightRequest="8" Aspect="Fill" HorizontalOptions="Start" />

                    <VerticalStackLayout Grid.Row="2" Margin="0,18,0,0" Spacing="16">
                        <controls:StoryTextLabel Style="{StaticResource StoryParagraph}" StoryText="{x:Static res:AppResources.FullVersionText}" />
                        <Label Style="{StaticResource Hint}" LineHeight="1.35" Text="{x:Static res:AppResources.FullVersionHint}" />
                        <controls:SketchTextButton
                            Margin="0,6,0,0"
                            Text="{Binding BuyText}"
                            Command="{Binding BuyFullVersionCommand}"
                            SemanticProperties.Description="{x:Static res:AppResources.Buy}" />
                        <controls:SketchTextButton
                            Text="{x:Static res:AppResources.Restore}"
                            CornerRadius="10,15,16,11"
                            Command="{Binding RestoreFullVersionCommand}"
                            SemanticProperties.Description="{x:Static res:AppResources.RestoreDescription}" />
                    </VerticalStackLayout>
                </Grid>
            </controls:InkFrame>
        </Grid>

        <!-- ===== Poprzednio… (po dłuższej przerwie w grze) ===== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsRecapOpen}">
            <BoxView Color="{StaticResource Scrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseRecapCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <controls:InkFrame
                Margin="24,72"
                FrameBackgroundColor="{DynamicResource PanelSolid}"
                MaximumWidthRequest="420"
                VerticalOptions="Center">
                <Grid Padding="22,26,18,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

                    <Label Text="{x:Static res:AppResources.RecapTitle}" Style="{StaticResource StoryTitle}" FontSize="34" VerticalOptions="Center" />

                    <controls:ThemedImage Grid.Row="1" Source="decor_underline.png" WidthRequest="150" HeightRequest="8" Aspect="Fill" HorizontalOptions="Start" />

                    <VerticalStackLayout Grid.Row="2" Margin="0,18,0,0" Spacing="12">
                        <Label Text="{Binding RecapChapter}" Style="{StaticResource ItemName}" />
                        <Label Text="{x:Static res:AppResources.RecapChoices}" Style="{StaticResource Hint}" IsVisible="{Binding HasRecapChoices}" />
                        <ScrollView MaximumHeightRequest="320">
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding RecapChoices}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding ., StringFormat='– {0}'}" Style="{StaticResource Hint}" FontSize="16" LineHeight="1.35" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                        <controls:SketchTextButton
                            Margin="0,8,0,0"
                            Text="{x:Static res:AppResources.ReadOn}"
                            Command="{Binding CloseRecapCommand}"
                            SemanticProperties.Description="{x:Static res:AppResources.ReadOnDescription}" />
                    </VerticalStackLayout>
                </Grid>
            </controls:InkFrame>
        </Grid>
    </Grid>

</views:BasePage>
