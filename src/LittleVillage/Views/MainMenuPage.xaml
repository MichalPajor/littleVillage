<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="LittleVillage.Views.MainMenuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:LittleVillage.Resources.Strings"
    xmlns:controls="clr-namespace:LittleVillage.Controls"
    xmlns:views="clr-namespace:LittleVillage.Views"
    xmlns:vm="clr-namespace:LittleVillage.ViewModels"
    x:DataType="vm:MainMenuViewModel">

    <Grid RowDefinitions="*,Auto">

        <controls:SceneBackgroundView Grid.RowSpan="2" Scene="{Binding Scene}" IsInverted="{DynamicResource SceneInverted}" />

        <controls:InkFrame
            x:Name="MenuFrame"
            Grid.Row="1"
            Margin="24,0,24,40"
            MaximumWidthRequest="420">

            <VerticalStackLayout Padding="26,30,26,28" Spacing="0">

                <Label Text="{x:Static res:AppResources.MainMenuSubtitle}" Style="{StaticResource StoryChapter}" />
                <Label Text="{x:Static res:AppResources.MainMenuTitle}" Style="{StaticResource StoryTitle}" FontSize="46" />
                <controls:ThemedImage
                    Source="decor_underline.png"
                    WidthRequest="190"
                    HeightRequest="10"
                    Aspect="Fill"
                    HorizontalOptions="Start" />

                <!-- Menu -->
                <VerticalStackLayout Margin="0,28,0,0" Spacing="18" IsVisible="{Binding IsMainMenuVisible}">
                    <controls:SketchTextButton
                        Text="{x:Static res:AppResources.MenuNewGame}"
                        Command="{Binding NewGameCommand}"
                        SemanticProperties.Description="{x:Static res:AppResources.MenuNewGame}" />
                    <controls:SketchTextButton
                        Text="{x:Static res:AppResources.MenuContinue}"
                        CornerRadius="10,15,16,11"
                        Command="{Binding ContinueCommand}"
                        IsVisible="{Binding CanContinue}"
                        SemanticProperties.Description="{x:Static res:AppResources.MenuContinueDescription}" />
                    <controls:SketchTextButton
                        Text="{x:Static res:AppResources.MenuStoryBook}"
                        FontSize="23"
                        CornerRadius="14,11,10,15"
                        Command="{Binding OpenStoryBookCommand}"
                        SemanticProperties.Description="{x:Static res:AppResources.MenuStoryBook}" />
                    <!-- Ustawienia i ocena — same ikonki, bez napisów -->
                    <HorizontalStackLayout Spacing="22" HorizontalOptions="Center">
                        <controls:SketchIconButton
                            FaceSize="62,62"
                            IconSize="36"
                            Icon="ic_settings.png"
                            StrokeThickness="4"
                            CornerRadius="12,9,14,10"
                            Command="{Binding OpenSettingsCommand}"
                            SemanticProperties.Description="{x:Static res:AppResources.MenuSettings}" />
                        <controls:SketchIconButton
                            FaceSize="62,62"
                            IconSize="36"
                            Icon="ic_star.png"
                            StrokeThickness="4"
                            CornerRadius="9,13,10,14"
                            Command="{Binding RateCommand}"
                            SemanticProperties.Description="{x:Static res:AppResources.MenuRateDescription}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Potwierdzenie nadpisania zapisu -->
                <VerticalStackLayout Margin="0,24,0,0" Spacing="18" IsVisible="{Binding IsConfirmingNewGame}">
                    <Label Style="{StaticResource StoryParagraph}" Text="{x:Static res:AppResources.NewGameConfirm}" />
                    <controls:SketchTextButton Text="{x:Static res:AppResources.NewGameYes}" Command="{Binding ConfirmNewGameCommand}" />
                    <controls:SketchTextButton Text="{x:Static res:AppResources.No}" CornerRadius="10,15,16,11" Command="{Binding CancelNewGameCommand}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </controls:InkFrame>
    </Grid>

</views:BasePage>
