<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Na razie tylko Android. iOS dopiszemy tutaj (net10.0-ios) po publikacji w Google Play;
		     każda dodatkowa platforma wymaga zainstalowanego workloadu, inaczej restore pada w całości. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>LittleVillage</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Generowanie kodu z XAML w czasie kompilacji (szybsze działanie, błędy bindingów wykrywane przy budowaniu). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>

		<!-- Display name -->
		<ApplicationTitle>Mała wioska</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.littlevillage.game</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 6.0 — tyle wymaga Google Play Billing (zakup pełnej wersji). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#000000" />

		<!-- Splash Screen (natywny, przed ekranem powitalnym aplikacji) -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000000" BaseSize="96,102" />

		<!-- Images: pliki SVG są rasteryzowane do PNG w czasie budowania; w XAML odwołujemy się do nich jako *.png -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Napisy interfejsu: AppResources.resx (polski) + AppResources.<język>.resx. Klasa AppResources
		     powstaje przy budowaniu (w XAML: {x:Static res:AppResources.Klucz}). -->
		<EmbeddedResource Update="Resources\Strings\AppResources.resx">
			<StronglyTypedFileName>$(IntermediateOutputPath)AppResources.Designer.cs</StronglyTypedFileName>
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>LittleVillage.Resources.Strings</StronglyTypedNamespace>
			<StronglyTypedClassName>AppResources</StronglyTypedClassName>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<!-- Wersja jawna (nie $(MauiVersion)), bo CommunityToolkit.Maui 15 wymaga MAUI >= 10.0.90. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<!-- Zakup pełnej wersji w Google Play (Play Billing Library 8). -->
		<PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
		<!-- Okno oceny Google Play (In-App Review) po ukończeniu gry. -->
		<PackageReference Include="Xamarin.Google.Android.Play.Review" Version="2.0.2.10" />
		<!-- Review ciągnie androidx.fragment 1.9 (z wbudowanym ktx); stary Fragment.Ktx 1.8 z MAUI dublowałby klasy (D8). -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LittleVillage.Core\LittleVillage.Core.csproj" />
	</ItemGroup>

	<!-- =====================================================================
	     Fabuła ink: Story\main.ink (oryginał) -> story.json, a każde tłumaczenie
	     Story\<język>\main.ink -> story.<język>.json — przy każdym budowaniu
	     (tylko gdy coś się zmieniło). Błędy w fabule i tłumaczenia o innej
	     strukturze niż oryginał pojawiają się jako błędy kompilacji.
	     ===================================================================== -->
	<PropertyGroup>
		<InkStoryDirectory>$(MSBuildProjectDirectory)\Story</InkStoryDirectory>
		<InkOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'ink'))</InkOutputDirectory>
		<InkOutputFile>$(InkOutputDirectory)story.json</InkOutputFile>
		<InkBuildProject>$(MSBuildProjectDirectory)\..\..\tools\LittleVillage.InkBuild\LittleVillage.InkBuild.csproj</InkBuildProject>
	</PropertyGroup>

	<ItemGroup>
		<InkSource Include="Story\**\*.ink" />
		<None Remove="Story\**\*.ink" />
		<None Include="@(InkSource)" />

		<!-- Kompilator fabuły: referencja tylko po to, by NuGet restore i kolejność budowania go obejmowały.
		     Nic z niego nie trafia do aplikacji (ReferenceOutputAssembly=false). -->
		<ProjectReference Include="$(InkBuildProject)"
		                  ReferenceOutputAssembly="false"
		                  Private="false"
		                  SkipGetTargetFrameworkProperties="true"
		                  GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained" />
	</ItemGroup>

	<Target Name="BuildInkCompiler" Condition="'$(DesignTimeBuild)' != 'true'">
		<MSBuild Projects="$(InkBuildProject)"
		         Targets="Build"
		         Properties="Configuration=$(Configuration);Platform=AnyCPU"
		         RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
			<Output TaskParameter="TargetOutputs" PropertyName="InkCompilerPath" />
		</MSBuild>
	</Target>

	<Target Name="CompileInkStory"
	        DependsOnTargets="BuildInkCompiler"
	        Inputs="@(InkSource);$(InkCompilerPath)"
	        Outputs="$(InkOutputFile)"
	        Condition="'$(DesignTimeBuild)' != 'true'">
		<!-- Stare pliki (np. po usunięciu tłumaczenia) nie mogą trafić do aplikacji. -->
		<ItemGroup>
			<_OldInkStory Include="$(InkOutputDirectory)story*.json" />
		</ItemGroup>
		<Delete Files="@(_OldInkStory)" />
		<Exec Command="dotnet &quot;$(InkCompilerPath)&quot; &quot;$(InkStoryDirectory)&quot; &quot;$(InkOutputDirectory).&quot;" />
	</Target>

	<Target Name="IncludeInkStory" BeforeTargets="ProcessMauiAssets" DependsOnTargets="CompileInkStory">
		<ItemGroup>
			<_InkStory Include="$(InkOutputDirectory)story*.json" />
			<FileWrites Include="@(_InkStory)" />
			<MauiAsset Include="@(_InkStory)" LogicalName="%(Filename)%(Extension)" />
		</ItemGroup>
	</Target>

</Project>
