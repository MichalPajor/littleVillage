    - strzyga_1:    ~ return "冷えない死者"
    - strzyga_2:    ~ return "ストシガ"
    - mamuny_3:     ~ return "マムナたち"
    - starzec_3:    ~ return "苔の帽子の老人"
    - ogniki_2:     ~ return "鬼火"
    - stwor_3:      ~ return "水死霊"
    - zielarka_3:   ~ return "湖畔の薬草女"
    - pan_lasu_6:   ~ return "森の主"
    - uboze_3:      ~ return "かまどの精"
