<Project Sdk="Microsoft.NET.Sdk">

  <!-- Oficjalne źródła silnika ink (inkle Ltd, licencja MIT), wersja 1.2.1.
       https://github.com/inkle/ink — nie modyfikuj plików .cs, aktualizuj przez podmianę katalogu. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Ink.Runtime</RootNamespace>
    <AssemblyName>ink-engine-runtime</AssemblyName>
    <Version>1.2.1</Version>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <WarningLevel>0</WarningLevel>
    <NoWarn>$(NoWarn);1701;1702;1591;CS0618;CS0162;CS0168;CS0219;CS0414;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ink_compiler" />
  </ItemGroup>

</Project>
